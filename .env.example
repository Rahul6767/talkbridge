# Copy to .env.local and fill in real values. Never commit .env.local.
# Never paste real values into Notion, Slack, Discord, PRs or AI chats.
ELASTICSEARCH_URL=
# App key: read-only on talkbridge-sessions
ELASTICSEARCH_API_KEY=
# Seed key: write access, laptop only, never deployed
ELASTICSEARCH_SEED_API_KEY=
# Optional: inference endpoint id for semantic_text (see GET _inference)
ELASTICSEARCH_INFERENCE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Development-only fault injection; never true in production
TALKBRIDGE_DEMO_FAIL_AI=false
OTEL_SERVICE_NAME=talkbridge
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=always_on
# Browser RUM: separate ingest-only token, visible to users by design
NEXT_PUBLIC_DASH0_RUM_ENDPOINT=
NEXT_PUBLIC_DASH0_RUM_TOKEN=
